{
    "manifest_version": 3,
    "name": "幸运草起始页",
    "version": "1.0.0",
    "description": "Edge 新标签页：Bing每日壁纸 / MSN天气 / 农历节气 / 多引擎搜索 / 网站快捷方式 / 唐诗宋词",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    }
}